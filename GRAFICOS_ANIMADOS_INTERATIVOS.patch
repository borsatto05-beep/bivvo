+ if(!text)return;
+ if(!tooltip){tooltip=document.createElement('div');tooltip.className='chart-tooltip';tooltip.hidden=true;document.body.append(tooltip);}
+ tooltip.textContent=text;tooltip.hidden=false;
+ const rect=node.getBoundingClientRect(),x=event.clientX||rect.left+rect.width/2,y=event.clientY||rect.top;
+ tooltip.style.left=Math.max(8,Math.min(innerWidth-tooltip.offsetWidth-8,x-tooltip.offsetWidth/2))+'px';
+ tooltip.style.top=Math.max(8,Math.min(innerHeight-tooltip.offsetHeight-8,y-tooltip.offsetHeight-14))+'px';
+}
+const observer=new IntersectionObserver(entries=>entries.forEach(({target,isIntersecting})=>{
+ if(!isIntersecting)return;
+ target.classList.add('chart-visible');observer.unobserve(target);
+ if(!reduced.matches){
+  const shapes=target.matches('svg')?target.querySelectorAll('path,circle.viz-seg,rect:not([fill="transparent"]),line[stroke="#00876c"]'):[];
+  shapes.forEach((shape,i)=>shape.animate([{opacity:0},{opacity:1}],{duration:650,delay:Math.min(i*35,350),easing:'ease-out'}));
+ }
+}),{threshold:.12});
+function enhance(root){
+ const charts=[...(root.matches?.(selector)?[root]:[]),...(root.querySelectorAll?.(selector)||[])];
+ charts.forEach(chart=>{
+  if(chart.matches('.ritmo-arc'))chart.setAttribute('tabindex','0');
+  if(seen.has(chart))return;seen.add(chart);chart.classList.add('chart-enhanced');observer.observe(chart);
+  const clear=()=>{chart.querySelectorAll('.chart-active,.chart-muted').forEach(x=>x.classList.remove('chart-active','chart-muted'));hide();};
+  const enter=e=>{
+   const node=e.target.closest?.('[role="button"],button,.ritmo-arc');if(!node||!chart.contains(node))return;
+   const key=node.dataset.chartKey;
