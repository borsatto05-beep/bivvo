+/* Pizza com legenda e acesso por teclado. */
+export function pie(items, { label='Gastos por categoria', onPick }={}) {
+  const entries=items.filter(x=>Number(x.value)>0), total=entries.reduce((sum,x)=>sum+Number(x.value),0);
+  if(!total) return h('p.muted', 'Nenhum gasto registrado neste mês.');
+  const chart=svg('svg',{viewBox:'0 0 200 200',role:'group','aria-label':label});
+  const legend=h('div.budget-pie-legend');
+  let angle=-Math.PI/2;
+  entries.forEach((item,i)=>{
+    const share=Number(item.value)/total, end=angle+share*2*Math.PI;
+    const color='hsl('+((275+i*137.508)%360).toFixed(1)+' 62% 48%)';
+    const description=item.label+': '+money0(item.value)+' · '+(share*100).toLocaleString('pt-BR',{maximumFractionDigits:1})+'%';
+    const pick=()=>onPick?.({...item,share,total});
+    const attrs={fill:color,stroke:'var(--card)', 'stroke-width':1.5,tabindex:'0',role:'button','aria-label':description};
+    const slice=entries.length===1
+      ?svg('circle',{...attrs,cx:100,cy:100,r:94})
+      :svg('path',{...attrs,d:'M 100 100 L '+(100+94*Math.cos(angle))+' '+(100+94*Math.sin(angle))+' A 94 94 0 '+(share>.5?1:0)+' 1 '+(100+94*Math.cos(end))+' '+(100+94*Math.sin(end))+' Z'});
+    slice.append(svg('title',{},description));
+    slice.addEventListener('click',pick);
+    slice.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();pick();}});
+    chart.append(slice);
+    legend.append(h('button',{type:'button',onclick:pick,'aria-label':description},
+      h('i',{'aria-hidden':'true',vars:{'--slice-color':color}}),h('span',item.label),
+      h('b',money0(item.value)),h('small',(share*100).toLocaleString('pt-BR',{maximumFractionDigits:1})+'%')));
+    angle=end;
+  });
+  return h('div.budget-pie',chart,legend);
+}
