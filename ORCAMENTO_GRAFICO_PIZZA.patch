+.budget-callout-value{font-size:13px;font-weight:800;fill:var(--ink)}
+.budget-chart-caption{text-align:center;color:var(--ink-3);font-size:.74rem;margin:0 0 22px}
+.budget-breakdown{border:1px solid var(--line);border-radius:14px;overflow:hidden}
