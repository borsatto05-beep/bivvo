+ 'Papel e celulose':['SUZB','KLBN','RANI'],
+ 'Construção e imóveis':['CYRE','MRVE','DIRR','EZTC','EVEN','TEND','TRIS','CURY','JHSF','MULT','IGTI','ALOS','LOGG'],
+ 'Transportes e logística':['RAIL','RUMO','CCRO','MOTV','ECOR','STBP','HBSA','TGMA','PORT','VAMO','RENT','MOVI','SIMH'],
+ 'Tecnologia':['TOTS','LWSA','POSI','BMOB','SQIA'],
